{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src/sim/**/*.ts", "src/engine/**/*.ts", "src/data/**/*.ts", "src/config/**/*.ts"]
}
